# Copy this file to .env and fill in the values you have.
# The app is designed to run end-to-end with ONLY the two DATABASE_URLs set —
# email, LLM, and calendar all have safe local/fallback behaviour when their
# keys are missing. See CLAUDE.md / README for details.

# --- Database (required) ---------------------------------------------------
# Local dev Postgres, started with `docker compose up -d`.
DATABASE_URL="postgresql://hospital:hospital@localhost:5432/hospital?schema=public&connection_limit=20&pool_timeout=30"
# Separate database used ONLY by `npm test` / concurrency scripts. Never point
# this at the same database as DATABASE_URL — tests wipe it between runs.
TEST_DATABASE_URL="postgresql://hospital:hospital@localhost:5433/hospital_test?schema=public"

# --- Auth (required) ---------------------------------------------------------
# Any long random string. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"
# Auth.js v5 refuses requests whose Host header it doesn't recognise once
# NODE_ENV=production (an anti-DNS-rebinding check). Vercel sets this for
# you; anywhere else (this app's own `npm start`, Render, a bare VM) needs
# it set explicitly or every request 401s with "UntrustedHost".
AUTH_TRUST_HOST="true"

# --- Clinic settings ---------------------------------------------------------
# IANA timezone the clinic's working hours are defined in. All timestamps are
# stored in UTC in the DB; this is used only to interpret/display them.
APP_TIMEZONE="UTC"
# Same value, exposed to the browser (Next.js only inlines env vars prefixed
# NEXT_PUBLIC_, and only at build time) — the day rail needs it client-side
# to align slot times to the clinic's day, not the visitor's own timezone.
# Keep this in sync with APP_TIMEZONE by hand; there's no way to derive one
# from the other across the server/client boundary.
NEXT_PUBLIC_APP_TIMEZONE="UTC"

# --- Cron / background jobs (required) ---------------------------------------
# Shared secret the host's cron must send as `Authorization: Bearer <value>`
# when calling POST /api/jobs/tick. Prevents the public internet from
# triggering job runs.
CRON_SECRET="change-me-too"

# --- Demo reset (optional, hosted deployments only) ---------------------------
# Leave blank normally — POST /api/demo/reset wipes and re-seeds the whole
# database, so it's only enabled when this is set. Set it on the graded
# hosted deployment so the grader can reset demo state; the exact deliverable
# CLAUDE.md §9.3 asks for. Different secret from CRON_SECRET on purpose —
# this one is strictly more destructive.
DEMO_RESET_SECRET=""

# --- Token encryption (required once Google Calendar is used) ---------------
# 32-byte key (base64) used to encrypt stored OAuth refresh tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# --- Email (optional) ---------------------------------------------------------
# "ethereal" (default, no key needed — auto-creates a throwaway inbox you can
# view in a browser, used for local dev/demo) or "resend" (production).
EMAIL_PROVIDER="ethereal"
RESEND_API_KEY=""
EMAIL_FROM="Clinic <no-reply@example.com>"

# --- LLM / Gemini (optional) --------------------------------------------------
# Leave blank to run entirely on the deterministic rules-based fallback
# summariser — the app is fully functional without this key.
GEMINI_API_KEY=""
LLM_MODEL="gemini-1.5-flash"

# --- Google Calendar (optional) -----------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials (OAuth client ID,
# type "Web application"). Leave blank to run with calendar sync disabled;
# booking/leave/cancel flows work identically without it.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/oauth/callback"
