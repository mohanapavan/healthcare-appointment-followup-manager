// Prisma schema for the Healthcare Appointment & Follow-up Manager.
// See CLAUDE.md §5 for the design rationale. The partial unique index that
// actually prevents double-booking, and the leave-overlap exclusion
// constraint, are added by raw SQL in prisma/migrations (Prisma cannot
// express a partial/exclusion constraint declaratively).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum BookingStatus {
  HELD
  CONFIRMED
  COMPLETED
  CANCELLED_BY_PATIENT
  CANCELLED_BY_CLINIC
  NO_SHOW
  // Not in CLAUDE.md's state diagram verbatim, but needed to distinguish "the
  // hold TTL lapsed" from an explicit cancellation in the audit trail; the
  // partial unique index excludes it from the active set exactly like the
  // other terminal states, so the slot is immediately bookable again.
  EXPIRED
}

enum OutboxType {
  BOOKING_CONFIRMATION
  BOOKING_REMINDER
  BOOKING_CANCELLATION
  MEDICATION_REMINDER
  CALENDAR_CREATE
  CALENDAR_UPDATE
  CALENDAR_DELETE
  // The LLM call is dispatched from here, never inline in a request handler
  // (CLAUDE.md hard rule #3: "the LLM is never on the critical path").
  AI_PRE_VISIT_GENERATION
  AI_POST_VISIT_GENERATION
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum AiEntityType {
  BOOKING_PRE_VISIT
  PRESCRIPTION_POST_VISIT
}

enum AiSource {
  LLM
  FALLBACK
}

enum AiUrgency {
  LOW
  MEDIUM
  HIGH
}

enum CalendarProvider {
  GOOGLE
}

enum ConnectionStatus {
  ACTIVE
  BROKEN
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctorProfile         DoctorProfile?
  patientBookings       Booking[]              @relation("PatientBookings")
  calendarLinks         CalendarLink[]
  googleCalendarAccount GoogleCalendarAccount?
  auditLogs             AuditLog[]

  @@index([role])
}

model DoctorProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialisation   String
  slotDurationMins Int      @default(30)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workingHours  WorkingHours[]
  leaves        Leave[]
  bookings      Booking[]
  prescriptions Prescription[]

  @@index([specialisation])
}

model WorkingHours {
  id              String        @id @default(uuid())
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  dayOfWeek       Int // 0 = Sunday .. 6 = Saturday, in APP_TIMEZONE
  startMinute     Int // minutes since local midnight
  endMinute       Int

  @@unique([doctorProfileId, dayOfWeek])
}

model Leave {
  id              String        @id @default(uuid())
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  startDate       DateTime      @db.Date
  endDate         DateTime      @db.Date
  reason          String
  createdAt       DateTime      @default(now())

  @@index([doctorProfileId, startDate, endDate])
}

// ---------------------------------------------------------------------------
// Booking — the state machine at the centre of the system
// ---------------------------------------------------------------------------

model Booking {
  id              String        @id @default(uuid())
  patientId       String
  patient         User          @relation("PatientBookings", fields: [patientId], references: [id])
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id])
  status          BookingStatus @default(HELD)
  startsAt        DateTime
  endsAt          DateTime

  // Two-phase hold (CLAUDE.md §1.3)
  holdToken     String?   @unique
  holdExpiresAt DateTime?

  // Idempotent confirm (CLAUDE.md §1.4) — NULLs don't collide under Postgres
  // unique semantics, so this only constrains rows that actually set a key.
  idempotencyKey String?

  cancelReason  String?
  cancelledAt   DateTime?
  correlationId String    @default(uuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  symptomSubmission SymptomSubmission?
  prescription      Prescription?
  calendarLinks     CalendarLink[]

  @@unique([patientId, idempotencyKey])
  @@index([doctorProfileId, startsAt])
  @@index([patientId, startsAt])
  @@index([status, holdExpiresAt])
}

model SymptomSubmission {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  patientId   String
  symptomText String
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// AI generation audit log — deliberately polymorphic (entityType + entityId,
// no FK) because it is an append-only audit trail, not a live relation.
// ---------------------------------------------------------------------------

model AiGeneration {
  id            String       @id @default(uuid())
  entityType    AiEntityType
  entityId      String
  correlationId String?
  promptVersion String
  model         String
  source        AiSource
  rawResponse   String?
  parsedOutput  Json?
  urgency       AiUrgency?
  latencyMs     Int
  tokenCount    Int?
  errorMessage  String?
  createdAt     DateTime     @default(now())

  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Post-visit: notes, prescription, medication schedule
// ---------------------------------------------------------------------------

model Prescription {
  id              String        @id @default(uuid())
  bookingId       String        @unique
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  doctorProfileId String
  doctorProfile   DoctorProfile @relation(fields: [doctorProfileId], references: [id])
  patientId       String
  clinicalNotes   String
  createdAt       DateTime      @default(now())

  items PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationName String
  dosage         String
  timesPerDay    Int
  durationDays   Int
  instructions   String?
  createdAt      DateTime     @default(now())
}

// ---------------------------------------------------------------------------
// Transactional outbox — the only path email/calendar side effects travel
// ---------------------------------------------------------------------------

model OutboxEvent {
  id                String       @id @default(uuid())
  type              OutboxType
  payload           Json
  status            OutboxStatus @default(PENDING)
  attempts          Int          @default(0)
  nextAttemptAt     DateTime     @default(now())
  lastError         String?
  providerMessageId String?
  correlationId     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// Google Calendar
// ---------------------------------------------------------------------------

model CalendarLink {
  id              String           @id @default(uuid())
  bookingId       String
  booking         Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ownerUserId     String
  owner           User             @relation(fields: [ownerUserId], references: [id])
  provider        CalendarProvider @default(GOOGLE)
  externalEventId String?
  status          ConnectionStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([bookingId, ownerUserId])
}

model GoogleCalendarAccount {
  id                    String           @id @default(uuid())
  userId                String           @unique
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedAccessToken  String
  encryptedRefreshToken String
  expiryDate            DateTime
  scope                 String
  status                ConnectionStatus @default(ACTIVE)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
